        "text": "好吧",
        "kingChange": -15,
        "yearDelta": 0
      },
      {
        "text": "叉出去",
        "kingChange": 5,
        "yearDelta": 0
      }
    ]
  },
  {
    "id": "00103",
    "title": "国史实录00103",
    "speaker": "共伯",
    "body": "这句我也记下来了",
    "options": [
