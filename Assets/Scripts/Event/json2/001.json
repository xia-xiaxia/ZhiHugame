      }
    ]
  },
  {
    "id": "00103",
    "title": "国史实录00103",
    "speaker": "共伯",
    "body": "这句臣也记下来了",
    "options": [
      {
        "text": "叉出去",
        "kingChange": 5,
        "yearDelta": 0
      },
      {
        "text": "记就记",
        "kingChange": -20,
        "yearDelta": 0
      }
